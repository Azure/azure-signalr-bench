# Declare build-time args before any FROM
ARG IMAGE
ARG POD

# Keep the configured base image, but use the same supported Node version for build and runtime.
FROM ${IMAGE} AS node-runtime
RUN curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/setup-node.sh && \
    bash /tmp/setup-node.sh && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -f /tmp/setup-node.sh && \
    rm -rf /var/lib/apt/lists/*

# Stage 1: build
FROM node-runtime AS build
ARG POD
WORKDIR /src
COPY . .
WORKDIR /src/Pods/${POD}
RUN npm ci --include=dev --engine-strict
RUN npm run build

# Stage 2: runtime
FROM node-runtime AS runtime
ARG POD  # Re-declare ARG if used in this stage
WORKDIR /app
COPY --from=build /src/Pods/${POD} ./
ENV NODE_ENV=production
ENTRYPOINT node server.js
# ENTRYPOINT ["sleep","infinity"]
